{
  "name": "buyers-workbench-browser-runner",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run test:host",
    "test:host": "python3 -m unittest discover -s test -p '*_test.py' -v",
    "collect": "node src/cli.ts",
    "provision": "python3 provision-session.py"
  },
  "dependencies": {
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
