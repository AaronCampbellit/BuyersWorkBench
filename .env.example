# Local development only. All published ports stay on 127.0.0.1.
BWB_WEB_PORT=4180
APP_ORIGIN=http://127.0.0.1:4180
# Optional explicit browser forwarding aliases, separated by commas.
# Only HTTP loopback origins are accepted in development mode.
APP_DEV_ALLOWED_ORIGINS=
# Generated database credentials live in .local/ and are read as files.
# No supplier credentials or owner passwords belong in this file.

# Optional owner-only Cloudflare Tunnel profile; set these before using tunnel-up.
# BWB_PUBLIC_HOST=app.example.com
# BWB_PUBLIC_ORIGIN=https://app.example.com
# BWB_HOST_UID=1000
# BWB_HOST_GID=1000
